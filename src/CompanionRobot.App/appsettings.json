{
  "Application": {
    "Name": "CompanionRobot",
    "DebugMode": true
  },
  "AI": {
    "Provider": "Mock",
    "ModelPath": "models/llm/model.gguf",
    "Endpoint": "",
    "ContextWindow": 8192,
    "MaxTokens": 256,
    "Temperature": 0.7,
    "AllowMockFallback": true
  },
  "Speech": {
    "Provider": "Mock",
    "ExecutablePath": "",
    "ModelPath": "models/whisper/ggml-base.en.bin",
    "Language": "en",
    "EnablePartialResults": true,
    "AutoSendRecognizedSpeech": false,
    "AllowMockFallback": true
  },
  "Hardware": {
    "Enabled": false,
    "PortName": "COM3"
  },
  "Persistence": {
    "SessionFilePath": "Data/session.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
