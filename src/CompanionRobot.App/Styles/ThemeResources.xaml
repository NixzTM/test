<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#111827" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="#1F2937" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#F8FAFC" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#F8FAFC" />
    </Style>

    <Style x:Key="MiniHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#CBD5E1" />
    </Style>

    <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#94A3B8" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#F8FAFC" />
    </Style>

    <Style x:Key="WarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
        <Setter Property="Foreground" Value="#FBBF24" />
    </Style>

    <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
        <Setter Property="Foreground" Value="#F87171" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="BorderBrush" Value="#1D4ED8" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="BorderBrush" Value="#334155" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
